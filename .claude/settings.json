{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "Agent",
      "Skill",
      "TodoWrite",
      "EnterWorktree",
      "ExitWorktree",
      "Bash(pnpm *)",
      "Bash(corepack *)",
      "Bash(COREPACK_ENABLE_DOWNLOAD_PROMPT=* *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(tsx *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(GH_TOKEN=* gh *)",
      "Bash(export GH_TOKEN=*)",
      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(bash scripts/*)",
      "Bash(bash .claude/hooks/*)",
      "Bash(sh scripts/*)",
      "Bash(jq *)",
      "Bash(curl http://localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -sS http://localhost:*)",
      "Bash(lsof *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(python3 -I *)",
      "Bash(cd *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(sleep *)",
      "Bash(kill *)",
      "Bash(pkill -f *)",
      "Bash(rm -rf node_modules*)",
      "Bash(rm -rf dist*)",
      "Bash(rm -rf .next*)",
      "Bash(rm -rf .turbo*)",
      "Bash(rm -rf coverage*)",
      "Bash(rm -rf .claude/.review*)",
      "Bash(rm -f *)",
      "mcp__claude-in-chrome__*"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin --force*)",
      "Bash(git reset --hard origin*)",
      "Bash(git clean -fdx*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf ..*)",
      "Bash(gh repo delete*)",
      "Bash(gh pr merge*)",
      "Read(./.env)",
      "Read(./**/.env)"
    ]
  },
  "env": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
    "TURBO_TELEMETRY_DISABLED": "1",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/create-worktree.sh\"",
            "timeout": 600,
            "statusMessage": "Creating worktree: copying env files + pnpm install"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-review-before-commit.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lessons-before-edit.sh\"",
            "timeout": 20,
            "statusMessage": "Checking lessons for this file"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-on-edit.sh\"",
            "timeout": 30,
            "statusMessage": "Linting the edited file"
          }
        ]
      }
    ]
  }
}
