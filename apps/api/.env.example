# WhiteBank Lending API — copy to apps/api/.env for local development.
# All values here are for a local machine; nothing in this file is a secret.

# development | test | production
NODE_ENV=development
# Port the API listens on (the backoffice proxies /api/* to it).
PORT=3101
# Postgres (pnpm db:up starts it on 127.0.0.1:5436).
DATABASE_URL=postgres://loan:loan_dev_password@127.0.0.1:5436/loan_dev
# Signs the demo session cookie. At least 32 characters; use a random value when deployed.
JWT_SECRET=dev-only-secret-change-me-at-least-32-chars
# Origin of the backoffice, allowed by CORS.
CORS_ORIGIN=http://localhost:3100
# Minutes after which a simulated failure mode switches itself back to OK.
SIMULATION_AUTO_RESET_MINUTES=15
# How long a simulated TIMEOUT waits before failing, in milliseconds.
SIMULATION_TIMEOUT_MS=3000
# Serve Swagger at /docs (true for local development only; unset or blank means off).
SWAGGER_ENABLED=true
# How long a migrator waits for another one holding the migration lock, in milliseconds.
MIGRATION_LOCK_TIMEOUT_MS=300000
# Run pending migrations when the API starts (true for deployments).
MIGRATE_ON_BOOT=false
# Seconds between expiry sweeps (drafts after 30 days, offers after 5 → Expired). 0 = off.
EXPIRY_SWEEP_SECONDS=300
# Seconds between notification sweeps (borrower messages sent, SLA-breach alerts). 0 = off.
NOTIFICATION_SWEEP_SECONDS=30

# Proxies in front of the API trusted for X-Forwarded-For (0 = never trust the header).
TRUST_PROXY_HOPS=0

# Decision providers (bureau, KYC/AML, fraud). Attempts per call (1 = no retry); backoff base
# in ms (0 = retry at once); failed calls in a row that pause a service; how long it stays
# paused in ms (0 = never skip a call); days a bureau report is reused (0 = never reuse).
# Keep attempts x (provider timeout + backoff) well under the 60 s decision target.
PROVIDER_RETRY_ATTEMPTS=3
PROVIDER_RETRY_BASE_MS=200
PROVIDER_CIRCUIT_THRESHOLD=5
PROVIDER_CIRCUIT_OPEN_MS=30000
BUREAU_CACHE_DAYS=30
