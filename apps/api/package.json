{
  "name": "@loan/api",
  "version": "0.1.0",
  "private": true,
  "description": "WhiteBank Lending API: NestJS bootstrap, environment, composition root and the simulated external services.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env --watch-path=dist --watch-path=../../packages/base/dist --watch-path=../../packages/core/dist --watch-path=../../packages/contracts/dist dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --cache --no-error-on-unmatched-pattern src test",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "db:migrate": "node --env-file-if-exists=.env dist/cli/db.js migrate",
    "db:seed": "node --env-file-if-exists=.env dist/cli/db.js seed",
    "db:reset": "node --env-file-if-exists=.env dist/cli/db.js reset",
    "db:migration:generate": "node --env-file-if-exists=.env node_modules/typeorm/cli.js migration:generate -d dist/cli/typeorm-data-source.js",
    "db:migration:check": "node --env-file-if-exists=.env node_modules/typeorm/cli.js migration:generate --check -d dist/cli/typeorm-data-source.js ../../packages/base/src/database/migrations/Drift"
  },
  "dependencies": {
    "@loan/base": "workspace:*",
    "@loan/contracts": "workspace:*",
    "@loan/core": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "typescript": "~5.9.3"
  }
}
