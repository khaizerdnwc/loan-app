# WhiteBank Lending backoffice — copy to apps/backoffice/.env.local for local development.
# Where the backoffice's /api/* route forwards requests (the API, server-side only).
# Required when NODE_ENV=production; defaults to http://localhost:3101 otherwise.
API_URL=http://localhost:3101
# Load balancers in front of the backoffice that append the client address to X-Forwarded-For
# (0 = none: no client address is passed to the API). Set it to the real count when deployed
# behind one, and set the API's TRUST_PROXY_HOPS=1 (docs/DEPLOY.md).
WEB_TRUST_PROXY_HOPS=0
# Set by Next itself (development for `next dev`, production for `next build`/`start`);
# listed because env.ts reads it to decide whether API_URL is required.
NODE_ENV=development
